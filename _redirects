# Cloudflare Pages redirect rules
# Fixes "Page with redirect" and canonical issues in Google Search Console

# The www-to-apex redirect is handled by the active Cloudflare Redirect Rule.

# Retire malformed historical URLs such as
# /framelimit.com/index.html and /framelimit.com/reviews.html.
/framelimit.com / 301
/framelimit.com/ / 301
/framelimit.com/index.html / 301
/framelimit.com/* /:splat 301

# Redirect any old /guides/ path variants to root
/guides/* /:splat 301

# Redirect the legacy index URL to the homepage
/index.html / 301

# Historical buying-guide address; preserve its topic instead of homepage fallback.
/gaming-laptop-buying-guide-2026 /guide-gaming-laptop-buying-guide-2026 301
/gaming-laptop-buying-guide-2026.html /guide-gaming-laptop-buying-guide-2026 301

# Consolidate duplicate SCAR review URLs
/review-asus-rog-scar-16-2026 /review-asus-rog-strix-scar-16-2026 301
/review-asus-rog-scar-16-2026.html /review-asus-rog-strix-scar-16-2026 301
/review-asus-rog-scar-18-2026 /review-asus-rog-strix-scar-18-2026 301
/review-asus-rog-scar-18-2026.html /review-asus-rog-strix-scar-18-2026 301
